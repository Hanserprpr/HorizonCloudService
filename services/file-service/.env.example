# 应用配置
APP_NAME=file-service
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_DEBUG=true

# 服务器配置
SERVER_PORT=8083
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=120
SERVER_MAX_HEADER_BYTES=1048576

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=file_service
DB_SSL_MODE=disable
DB_TIMEZONE=UTC
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME_MINUTES=60
DB_LOG_LEVEL=info

# 存储配置
STORAGE_BACKEND=local

# MinIO配置 (当STORAGE_BACKEND=minio时)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=file-service
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# S3配置 (当STORAGE_BACKEND=s3时)
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=file-service
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# 本地存储配置 (当STORAGE_BACKEND=local时)
LOCAL_STORAGE_ROOT=./storage

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_HOURS=24

# 用户服务配置
USER_SERVICE_BASE_URL=http://localhost:8081
USER_SERVICE_API_KEY=
USER_SERVICE_TIMEOUT_SECONDS=30
USER_SERVICE_RETRY_COUNT=3
USER_SERVICE_RETRY_INTERVAL_SECONDS=5
USER_SERVICE_ENABLE_CIRCUIT_BREAKER=true

# 配额配置
QUOTA_DEFAULT_STORAGE_QUOTA=5368709120  # 5GB in bytes
QUOTA_DEFAULT_FILE_COUNT=10000
QUOTA_CHECK_INTERVAL_MINUTES=5
QUOTA_GRACE_BUFFER=0.1  # 10%
QUOTA_ENABLE_WARNINGS=true
QUOTA_WARNING_THRESHOLD=0.8  # 80%