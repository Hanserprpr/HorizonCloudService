# 开发环境配置 - 文件服务
APP_NAME=file-service
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_DEBUG=true

# 服务器配置 - 设置为端口8002与前端期望匹配
SERVER_PORT=8002
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=120

# 数据库配置 - 开发环境使用SQLite
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=file_service
DB_SSL_MODE=disable
DB_TIMEZONE=UTC
DB_LOG_LEVEL=info

# 存储配置 - 本地存储
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./uploads

# JWT配置
JWT_SECRET=your-development-secret-key
JWT_EXPIRATION_HOURS=24

# 用户服务配置
USER_SERVICE_BASE_URL=http://localhost:8001
USER_SERVICE_API_KEY=
USER_SERVICE_TIMEOUT_SECONDS=30

# 配额配置
QUOTA_DEFAULT_STORAGE_QUOTA=5368709120
QUOTA_DEFAULT_FILE_COUNT=10000
QUOTA_CHECK_INTERVAL_MINUTES=5
QUOTA_ENABLE_WARNINGS=true
QUOTA_WARNING_THRESHOLD=0.8