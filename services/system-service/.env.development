# System Service Development Configuration

# Server Configuration
PORT=8003
GIN_MODE=debug

# Authentication Configuration
JWT_SECRET=your-secret-key
SKIP_AUTH=true

# Database Configuration
DATABASE_URL=system-service.db

# Service URLs
USER_SERVICE_URL=http://localhost:8001
FILE_SERVICE_URL=http://localhost:8002

# Cache Configuration
REDIS_URL=localhost:6379

# Storage Configuration (Default Values)
DEFAULT_STORAGE_TYPE=local
DEFAULT_LOCAL_PATH=./uploads
DEFAULT_QUOTA=10737418240
DEFAULT_MAX_FILE_SIZE=104857600
DEFAULT_ALLOWED_TYPES=image/*,text/*,application/pdf,application/zip