# 用户服务开发环境配置
APP_NAME=user-service
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# JWT配置 - 与文件服务保持一致
JWT_SECRET=your-development-secret-key
JWT_EXPIRATION_HOURS=24

# 服务器配置  
SERVER_PORT=8001
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=user_service
DB_SSL_MODE=disable